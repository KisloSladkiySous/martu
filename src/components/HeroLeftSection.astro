---
import Circle from "../components/Circle.astro";
import Subtle from "../components/Subtle.astro";
import HeroCircle from "../assets/images/hero-circle.webp";
import HeroSign from "../assets/icons/sign/hero-sign.svg";
import SvgAnimation from "../components/SvgAnimation.astro";
import CircleAlt from "./CircleAlt.astro";

const { className } = Astro.props;
---

<div class:list={[className, "section-column__wrapper"]}>
  <div class="section-column__wrapper-inner">
    <Subtle
      lines={["Создадим не только", "праздник, но и повод"]}
      delay={400}
    />
    <h1 class="section__title">
      Мы - заодно <br /> с
      <span class="brand-color italic underline">
        Вами
        <SvgAnimation>
          <HeroSign />
        </SvgAnimation>
      </span>
    </h1>
    <div class="hero-section__visual-element">
      <CircleAlt
        borderColor="white"
        imagePath={HeroCircle.src}
        height="13.43rem"
      />
    </div>
    <p class="text hero-section__description">
      <span class="brand-color">Martu</span> - мы свадебное агентство. Здесь каждый
      не случайно. Люди, которые любят свое дело и красиво воплощают любовь. Наша
      команда профессионалов готова реализовать любые задумки и пожелания!
    </p>
  </div>
</div>

<script>
  import { animate, inView, scale, stagger } from "motion";

  inView("#hero-0", (target) => {
    const elementsToAnimate = [
      ...target.querySelectorAll(".hero-section__visual-element > *"),
    ];

    const sectionTitle = target.querySelector(".section__title");
    const sectionDescription = target.querySelector(
      ".hero-section__description"
    );

    if (elementsToAnimate.length === 0) return;

    const sequence = [
      [
        sectionTitle,
        {
          opacity: [0, 1],
          y: [25, 0],
          filter: ["blur(8px)", "blur(0px)"],
        },
        {
          duration: 0.6,
          easing: "ease-out",
          delay: stagger(0.1, { startDelay: 0.3 }),
        },
      ],
      [
        [elementsToAnimate, elementsToAnimate[0].children[0]],
        {
          scale: [0.9, 1],
          opacity: [0, 1],
          filter: ["blur(8px)", "blur(0px)"],
        },
        {
          duration: 0.6,
          easing: "ease-out",
          delay: stagger(0.1, { startDelay: 0.3 }),
          at: 0.3,
        },
      ],
      [
        sectionDescription,
        {
          opacity: [0, 1],
          filter: ["blur(8px)", "blur(0px)"],
        },
        {
          duration: 0.6,
          easing: "ease-out",
          delay: stagger(0.1),
        },
      ],
    ];

    animate(sequence);

    return () => {};
  });
</script>

<style>
  .hero-section__visual-element {
    display: flex;
    justify-content: center;
    margin-top: 4.3125rem;
    margin-bottom: 5.4375rem;
  }
  .hero-section__description {
    text-align: center;
  }
  @media (max-width: 475px) {
    .hero-section__visual-element {
      margin-top: 3.25rem;
      margin-bottom: 2.25rem;
    }
  }
  @media (max-width: 375px) {
    .hero-section__visual-element {
      margin-top: 2.5rem;
      margin-bottom: 1.5rem;
    }
  }
</style>
