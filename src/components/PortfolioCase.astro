---
import { Image } from "astro:assets";

const { year, names, folder, images } = Astro.props;

const initialCount = 12;
const baseUrl = import.meta.env.STRAPI_URL;
---

<div class="case-wrapper">
  <span class="case-year">{year}</span>
  <h3 class="case-couple">{names}</h3>
  <div class="content">
    <div class="photo-grid" grid-section={folder}>
      {
        images.map((image: any, index: number) => {
          const isHidden = index >= initialCount;

          return (
            <div
              data-hidden={isHidden ? "true" : undefined}
              class={
                isHidden
                  ? "photo-grid-item_hidden photo-grid-item"
                  : "photo-grid-item_visible photo-grid-item"
              }
            >
              <Image
                src={`${baseUrl}${image.formats.medium.url}`}
                alt={image.alternativeText || `Фото ${index + 1}, ${names}`}
                loading="lazy"
                width={image.formats.medium.width}
                height={image.formats.medium.height}
                onload="this.classList.add('photo-grid-item_loaded')"
                sizes="(max-width: 600px) 100vw, (max-width: 900px) 50vw, 33vw"
                class="photo-grid-img fade"
              />
            </div>
          );
        })
      }
    </div>
  </div>

  {
    images.length > initialCount && (
      <div class="gallery-actions">
        <button
          id="load-more-btn"
          class="action-btn load-more"
          data-section={folder}
        >
          Загрузить ещё
        </button>

        <button
          id="hide-btn"
          class="action-btn hide"
          data-section={folder}
          style="display: none;"
        >
          Скрыть
        </button>
      </div>
    )
  }
  <div class="divider"></div>
</div>

<style>
  .fade {
    opacity: 0;
    filter: blur(8px);
    transition: opacity 0.6s ease;
  }
  .fade.photo-grid-item_loaded {
    opacity: 1;
    filter: blur(0px);
  }
  .photo-grid-item_hidden {
    display: none;
    opacity: 0;
  }

  .photo-grid-item_visible {
    opacity: 1;
  }

  .photo-grid-item {
    transition: opacity 0.6s ease-out;
    background-color: var(--card-color);
  }
  .divider {
    width: 50%;
    height: 1px;
    justify-content: center;
    display: flex;
    background-color: var(--border-color);
    margin: 0 auto;
    margin-top: 3rem;
  }
  .case-wrapper {
    display: flex;
    flex-direction: column;
  }
  .case-year {
    text-align: center;
    color: var(--text-color-secondary);
    margin-bottom: 1rem;
    font-size: var(--fs-14);
    line-height: var(--lh-14);
  }
  .case-couple {
    text-align: center;
    color: var(--text-color-secondary);
    margin: 0;
    font-size: var(--fs-46);
    line-height: var(--lh-46);
    font-weight: 400;
    margin-bottom: 4.4375rem;
  }
  .photo-grid {
    display: grid;
    gap: 1.125rem;
  }
  .gradient {
    height: 300px;
    content: "";
    position: absolute;
    top: 0;
    background: linear-gradient(
      to top,
      var(--background-color) 0%,
      rgba(102, 126, 234, 0) 100%
    );

    pointer-events: none;
  }

  .photo-grid-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .gallery-actions {
    display: flex;
    justify-content: center;
    position: relative;
    margin-top: 3rem;
    /* margin-bottom: 3rem; */
  }
  .load-more {
    color: var(--text-color-fifth);
    font-size: var(--fs-14);
    padding: 1em 3em;
    background: var(--card-color);
    border: 1px solid #f7eee0;
    border-radius: 999px;
  }

  @media (max-width: 1025px) {
    .photo-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 1rem;
    }
  }

  @media (min-width: 1200px) {
    .photo-grid {
      grid-template-columns: repeat(4, 1fr);
      gap: 20px;
    }
  }
</style>
<script>
  document.addEventListener("DOMContentLoaded", () => {
    const loadBtns = document.querySelectorAll(".load-more");
    const hideBtn = document.querySelector('[data-on-click="hideExtraPhotos"]');
    // console.log(loadBtns);

    // animatePhotos();

    if (loadBtns) {
      loadBtns.forEach((button) => {
        button.addEventListener("click", (event) => {
          const sectionName = button.getAttribute("data-section");
          loadMorePhotos(String(sectionName));
        });
      });
    }

    if (hideBtn) {
      hideBtn.addEventListener("click", (event) => {
        const sectionName = hideBtn.getAttribute(" data-section");
        hideExtraPhotos(sectionName);
      });
    }
  });

  function loadMorePhotos(sectionName: string) {
    const targetGrid = document.querySelector(
      `.photo-grid[grid-section=${sectionName}]`
    );
    const hiddenItems = targetGrid.querySelectorAll(
      `.photo-grid-item[data-hidden="true"]`
    );
    let shownCount = 0;
    const batchSize = 20;

    for (const item of hiddenItems) {
      if (shownCount >= batchSize) break;
      item.classList.add("photo-grid-item_visible");
      item.classList.remove("photo-grid-item_hidden");
      item.removeAttribute("data-hidden");
      shownCount++;
    }
    //не работает )
    // if (shownCount > 0) {
    //   const hideBtn = document.querySelector(
    //     `[data-section-name="${sectionName}"]`
    //   );
    //   if (hideBtn) hideBtn.style.display = "inline-block";
    // }
    // console.log(
    //   targetGrid.querySelectorAll(`.photo-grid-item[data-hidden="true"]`)
    // );

    if (
      targetGrid.querySelectorAll(`.photo-grid-item[data-hidden="true"]`)
        .length === 0
    ) {
      const loadBtn = document.querySelector(`[data-section="${sectionName}"]`);
      if (loadBtn) loadBtn.style.display = "none";
    }
  }

  function hideExtraPhotos(sectionName) {
    const allItems = document.querySelectorAll(
      `.photo-grid-item[data-section="${sectionName}"]`
    );
    allItems.forEach((item, index) => {
      // Здесь можно задать initialCount динамически, если нужно
      const initialCount = 12; // или брать из dataset
      if (index >= initialCount) {
        item.classList.remove("photo-grid-item_visible");
        item.classList.add("photo-grid-item_hidden");
        item.setAttribute("data-hidden", "true");
      }
    });

    const loadBtn = document.querySelector(
      `[data-section-name="${sectionName}"]`
    );
    const hideBtn = document.querySelector(
      `[data-section-name="${sectionName}"]`
    );

    if (loadBtn) loadBtn.style.display = "inline-block";
    if (hideBtn) hideBtn.style.display = "none";
  }
</script>
