  <dialog id="feedbackDialog">
    <h2>Оставьте ваши контакты</h2>
    <form id="feedbackForm">
      <div class="form-group">
        <label for="name">Имя:</label>
        <input type="text" id="name" name="name">
        <div class="error-message" id="nameError"></div>
      </div>
      <div class="form-group">
        <label for="phone">Телефон (11 цифр, например: 79123456789):</label>
        <input type="tel" id="phone" name="phone" inputmode="numeric" maxlength="11">
        <div class="error-message" id="phoneError"></div>
      </div>
      <div id="formMessage" class="success"></div>
      <div class="form-actions">
        <button type="button" id="cancelBtn">Отмена</button>
        <button type="submit">Отправить</button>
      </div>
    </form>
  </dialog>
<style>
  /* Сбросим только то, что нужно */
  dialog {
    border: none;
    border-radius: 16px;
    padding: 32px;
    width: 90vw; /* 90% ширины окна */
    max-width: 500px;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.25);
    background: #ffffff;
    font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    color: #333;
    margin: auto; /* важно для центрирования в dialog */
  }

  /* Фон затемнения */
  dialog::backdrop {
    background: rgba(0, 0, 0, 0.6);
    /* backdrop-filter не обязателен, но добавляет эффект */
    backdrop-filter: blur(4px);
  }

  dialog h2 {
    margin-top: 0;
    margin-bottom: 24px;
    font-size: 24px;
    font-weight: 600;
    color: #2c3e50;
    text-align: center;
  }

  .form-group {
    margin-bottom: 20px;
  }

  label {
    display: block;
    margin-bottom: 8px;
    font-weight: 600;
    font-size: 14px;
    color: #2c3e50;
  }

  input {
    width: 100%;
    padding: 12px 16px;
    box-sizing: border-box;
    border: 1px solid #ddd;
    border-radius: 8px;
    font-size: 16px;
    transition: border-color 0.2s, box-shadow 0.2s;
    background-color: #fafafa;
  }

  input:focus {
    outline: none;
    border-color: #3498db;
    box-shadow: 0 0 0 3px rgba(52, 152, 219, 0.2);
    background-color: #fff;
  }

  input.error {
    border-color: #e74c3c;
    background-color: #fdf2f2;
  }

  .error-message {
    min-height: 20px;
    margin-top: 6px;
    font-size: 13px;
    color: #e74c3c;
  }

  .success {
    color: #27ae60;
    font-weight: 600;
    text-align: center;
    margin-bottom: 16px;
    min-height: 24px;
  }

  .form-actions {
    display: flex;
    justify-content: flex-end;
    gap: 12px;
    margin-top: 16px;
  }

  .form-actions button {
    padding: 10px 20px;
    border: none;
    border-radius: 8px;
    font-size: 16px;
    font-weight: 600;
    cursor: pointer;
    transition: background-color 0.2s, transform 0.1s;
  }

  .form-actions button:hover {
    transform: translateY(-2px);
  }

  .form-actions button:active {
    transform: translateY(0);
  }

  #cancelBtn {
    background-color: #ecf0f1;
    color: #7f8c8d;
  }

  #cancelBtn:hover {
    background-color: #d5dbdb;
  }

  button[type="submit"] {
    background-color: #3498db;
    color: white;
  }

  button[type="submit"]:hover {
    background-color: #2980b9;
  }
</style> 
  <script>

    const dialog = document.getElementById('feedbackDialog') as HTMLDialogElement;
    const openBtn = document.getElementById('openDialog') as HTMLButtonElement;
    const cancelBtn = document.getElementById('cancelBtn') as HTMLButtonElement;
    const form = document.getElementById('feedbackForm') as HTMLFormElement;
    const nameInput = document.getElementById('name') as HTMLInputElement;
    const phoneInput = document.getElementById('phone') as HTMLInputElement;
    const nameError = document.getElementById('nameError') as HTMLDivElement;
    const phoneError = document.getElementById('phoneError') as HTMLDivElement;
    const formMessage = document.getElementById('formMessage') as HTMLDivElement;

    const API_URL = `http://127.0.0.1:1337/api/applications`; // Замените на ваш эндпоинт


    function clearErrors() {
      nameError.textContent = '';
      phoneError.textContent = '';
      nameInput.classList.remove('error');
      phoneInput.classList.remove('error');
      formMessage.textContent = '';
    }


    phoneInput.addEventListener('input', () => {
      phoneInput.value = phoneInput.value.replace(/\D/g, '').slice(0, 11);
    });


    phoneInput.addEventListener('keydown', (e) => {
      if (
        [46, 8, 9, 27, 13, 37, 38, 39, 40].includes(e.keyCode) ||
        (e.ctrlKey && [65, 67, 86, 88].includes(e.keyCode))
      ) return;
      if ((e.shiftKey || (e.keyCode < 48 || e.keyCode > 57)) && (e.keyCode < 96 || e.keyCode > 105)) {
        e.preventDefault();
      }
    });

 
    openBtn.addEventListener('click', () => {
      clearErrors();
      dialog.showModal();
    });

    cancelBtn.addEventListener('click', () => {
      dialog.close();
      clearErrors();
    });


    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      clearErrors();

      const name = nameInput.value.trim();
      const phone_number = phoneInput.value.trim();

      let hasError = false;

      if (!name) {
        nameError.textContent = 'Пожалуйста, укажите имя.';
        nameInput.classList.add('error');
        hasError = true;
      }

      if (!/^\d{11}$/.test(phone_number)) {
        phoneError.textContent = 'Телефон должен содержать ровно 11 цифр (например: 79123456789).';
        phoneInput.classList.add('error');
        hasError = true;
      }

      if (hasError) return;

      try {
        const response = await fetch(API_URL, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            data:{  phone_number, name}
          })
        });

        if (response.ok) {
          formMessage.textContent = 'Спасибо! Ваши данные успешно отправлены.';
          formMessage.className = 'success';
          form.reset();
          setTimeout(() => {
            dialog.close();
            clearErrors();
          }, 1500);
        } else {
          throw new Error('Ошибка сервера');
        }
      } catch (error) {
        console.error('Ошибка:', error);
        formMessage.textContent = 'Не удалось отправить данные. Попробуйте позже.';
        formMessage.className = 'error-message';
      }
    });
  </script>