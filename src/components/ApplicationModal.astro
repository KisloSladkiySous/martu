---
import Close from "../assets/icons/close.svg";
---


<dialog id="feedbackDialog">
  <div class="dialog-toolbar">
    <Close id="closeButton"></Close>
  </div>
  <h2 class="dialog-title">
    Получите бесплатную консультациюи подбор идеальных локаций!
  </h2>
  <form id="feedbackForm">
    <div class="form-group">
      <label for="name">Ваше имя:</label>
      <input type="text" id="name" name="name" placeholder="Иванов Иван" />
      <div class="error-message" id="nameError"></div>
    </div>
    <div class="form-group">
      <label for="phone">Ваш телефон:</label>
      <input
        type="tel"
        id="phone"
        name="phone"
        inputmode="numeric"
        placeholder="8(___) ___-__-__"
      />
      <div class="error-message" id="phoneError"></div>
    </div>

    <div class="form-actions">
      <button class="confirm-buton" id="confirmButton" type="submit"
        >Оставить заявку</button
      >
      <label class="agreement">
        <input type="checkbox" id="policy" />
        <span class="checkmark"></span>
        <!-- TODO: заменить на тег a -->
        Я соглашаюсь с <span class="brand-color italic"
          >политикой конфиденциальности</span
        > и обработкой персональных данных
      </label>
    </div>
    <div id="formMessage" class="success"></div>
  </form>
</dialog>
<style>
  dialog {
    border: none;
    padding: 26px;
    width: 67vw;
    max-width: 1200px;
    background: #f8f2e9;
    margin: auto;
  }

  dialog::backdrop {
    background: rgba(0, 0, 0, 0.6);
    backdrop-filter: blur(4px);
  }

  .dialog-title {
    margin-top: 0;
    margin-bottom: 24px;
    font-size: var(--fs-32);
    line-height: var(--lh-32);
    color: #444444;
    text-align: center;
  }
  #feedbackForm {
    padding: 2px 94px;
    max-width: 50%;
    margin: 0 auto;
  }
  #policy {
    width: 16px;
    height: 16px;
    background-color: #f0d8b5;
    border: 1px solid #caac81;
  }

  .form-group {
    margin-bottom: 20px;
  }

  label {
    display: block;
    margin-bottom: 8px;
    font-size: var(--fs-14);
    line-height: var(--lh-14);
    color: #444444;
  }

  input {
    width: 100%;
    box-sizing: border-box;
    border: 1px solid #f0d8b5;
    border-radius: 999px;
    font-size: 16px;
    background-color: #fff9f0;
    padding: 0.75rem 1.5rem;
    color: #444444;
  }

  input:focus {
    outline: none;
  }

  input.error {
    border-color: #e74c3c;
    background-color: #fdf2f2;
  }

  .error-message {
    min-height: 20px;
    margin-top: 6px;
    font-size: 13px;
    color: #e74c3c;
  }

  .success {
    color: #27ae60;
    font-weight: 600;
    text-align: center;
    margin-bottom: 16px;
    min-height: 24px;
  }

  .form-actions {
    display: flex;
    flex-direction: column;
    margin-top: 16px;
  }

  .form-actions button {
    cursor: pointer;
    background-color: #f0d8b5;
    transition:
      background-color 0.2s,
      transform 0.1s;
  }

  .confirm-buton {
    overflow: hidden;
    background-color: rgba(#f0d8b5, 1);
    color: #5a5348;
    font-size: var(--fs-18);
    line-height: var(--lh-18);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border: none;
    border-radius: 999px;
    text-align: center;
    display: inline-block;
    cursor: pointer;
    padding: 0.7em 2em;
    box-shadow: 0 10px 40px 10px rgb(255, 255, 255, 0);
    transition: all 0.2s ease-out;
  }

  @media (hover: hover) {
    .confirm-buton:hover {
      transform: scale(1.02) translateY(-5%);
      background-color: rgba(var(--backgroundColor), calc(var(--alpha) + 0.05));
      box-shadow: 0 4px 40px 20px rgb(255, 255, 255, 0.05);
    }
  }
  .confirm-buton:active {
    transform: scale(1.04) translateY(-5%);
    background-color: rgba(var(--backgroundColor), calc(var(--alpha) + 0.1));
  }
  .confirm-buton::before {
    content: "";
    background: linear-gradient(
      60deg,
      #0000,
      #0000,
      rgba(255, 255, 255, 0.15),
      #0000,
      #0000
    );
    width: 100%;
    height: 100%;
    animation: infinite slide-in 4s ease-out;
    position: absolute;
    top: 0;
    left: -100%;
    z-index: 1;
  }

  @keyframes slide-in {
    0%,
    20% {
      transform: translateX(0);
    }

    80%,
    100% {
      transform: translateX(300%);
    }
  }
  .agreement {
    margin-top: 18px;
  }
  .agreement input {
    display: none;
  }

  .checkmark {
    display: inline-block;
    width: 16px;
    height: 16px;
    border-radius: 6px;
    border: 1px solid #caac81;
    background-color: #caac81;
    vertical-align: middle;
    margin-right: 8px;
    position: relative;
    transition:
      background-color 0.2s,
      border-color 0.2s;
  }

  .agreement input:checked + .checkmark {
    background-color: #f0d8b5;
    border-color: #caac81 !important;
    border: 1px solid;
  }

  .agreement input:checked + .checkmark::after {
    content: "";
    position: absolute;
    left: 5px;
    top: 1px;
    width: 5px;
    height: 9px;
    border: solid #caac81;
    border-width: 0 2px 2px 0;
    transform: rotate(45deg);
  }
  .agreement input:checked + .checkmark:hover {
    background-color: #f0d8b5;
  }
  .confirm-buton:disabled {
  opacity: 0.6;
  cursor: not-allowed;
  transform: none !important;
  box-shadow: none !important;
}
.dialog-toolbar {
  display: flex;
  justify-content: flex-end;
}
#closeButton:hover {
  cursor: pointer;
}
</style>
<script>
  import IMask from 'imask';
  const dialog = document.getElementById("feedbackDialog") as HTMLDialogElement;
  const openBtn = document.getElementById("openDialog") as HTMLButtonElement;
  const form = document.getElementById("feedbackForm") as HTMLFormElement;
  const nameInput = document.getElementById("name") as HTMLInputElement;
  const phoneInput = document.getElementById("phone") as HTMLInputElement;
  IMask(
  phoneInput,
  {
    mask: '+{7}(000)000-00-00'
  }
)
  const nameError = document.getElementById("nameError") as HTMLDivElement;
  const phoneError = document.getElementById("phoneError") as HTMLDivElement;
  const formMessage = document.getElementById("formMessage") as HTMLDivElement;
  const confirmButton = document.getElementById(
    "confirmButton"
  ) as HTMLButtonElement;
  const closeButton = document.getElementById(
    "closeButton"
  ) as HTMLButtonElement;
  console.log(closeButton);
  
  const checkbox = document.getElementById("policy");
  confirmButton.disabled = true;
  const API_URL = `http://127.0.0.1:1337/api/applications`;
  function clearErrors() {
    nameError.textContent = "";
    phoneError.textContent = "";
    nameInput.classList.remove("error");
    phoneInput.classList.remove("error");
    formMessage.textContent = "";
  }

  // phoneInput.addEventListener("input", () => {
  //   phoneInput.value = phoneInput.value.replace(/\D/g, "").slice(0, 11);
  // });

  // phoneInput.addEventListener("keydown", (e) => {
  //   if (
  //     [46, 8, 9, 27, 13, 37, 38, 39, 40].includes(e.keyCode) ||
  //     (e.ctrlKey && [65, 67, 86, 88].includes(e.keyCode))
  //   )
  //     return;
  //   if (
  //     (e.shiftKey || e.keyCode < 48 || e.keyCode > 57) &&
  //     (e.keyCode < 96 || e.keyCode > 105)
  //   ) {
  //     e.preventDefault();
  //   }
  // });

  openBtn.addEventListener("click", () => {
    clearErrors();
    dialog.showModal();
  });
  closeButton.addEventListener('click', () => {
    clearErrors()
    dialog.close()
  })
  form.addEventListener("submit", async (e) => {
    e.preventDefault();
    clearErrors();

    const name = nameInput.value.trim();
    const phone_number = phoneInput.value.trim();

    let hasError = false;

    if (!name) {
      nameError.textContent = "Пожалуйста, укажите имя.";
      nameInput.classList.add("error");
      hasError = true;
    }

    // if (!/^\d{11}$/.test(phone_number)) {
    //   phoneError.textContent =
    //     "Телефон должен содержать ровно 11 цифр (например: 79123456789).";
    //   phoneInput.classList.add("error");
    //   hasError = true;
    // }

    if (hasError) return;

    try {
      const response = await fetch(API_URL, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          data: { phone_number, name },
        }),
      });

      if (response.ok) {
        formMessage.textContent = "Спасибо! Ваши данные успешно отправлены.";
        formMessage.className = "success";
        form.reset();
        setTimeout(() => {
          dialog.close();
          clearErrors();
        }, 1500);
      } else {
        throw new Error("Ошибка сервера");
      }
    } catch (error) {
      console.error("Ошибка:", error);
      formMessage.textContent =
        "Не удалось отправить данные. Попробуйте позже.";
      formMessage.className = "error-message";
    }
  });

  checkbox.addEventListener("change", () => {
    confirmButton.disabled = !checkbox.checked;
 
  });
</script>
