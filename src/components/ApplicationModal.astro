---
import Close from "../assets/icons/close.svg";
---

<dialog id="feedbackDialog">
  <div class="dialog-toolbar">
    <Close id="closeButton" />
  </div>
  <h2 class="dialog-title">
    Получите бесплатную консультацию <br class="desktop" />и подбор идеальных
    локаций!
  </h2>
  <form id="feedbackForm">
    <div class="form-inputs">
      <div class="form-group">
        <label for="name" class="form-input__label">Ваше имя:</label>
        <input
          class="form-input"
          type="text"
          id="name"
          name="name"
          required
          placeholder="Ваше имя"
        />
        <div class="error-message" id="nameError"></div>
      </div>

      <div class="form-group">
        <label for="phone" class="form-input__label">Ваш телефон:</label>
        <input
          class="form-input"
          required
          type="tel"
          id="phone"
          name="phone"
          inputmode="numeric"
          placeholder="8 (___) ___-__-__"
        />
        <div class="error-message" id="phoneError"></div>
      </div>
    </div>

    <div class="form-actions">
      <button class="confirm-buton" id="confirmButton" type="submit"
        >Оставить заявку</button
      >
      <label class="agreement" for="policy">
        <input type="checkbox" id="policy" />
        <span class="checkmark"></span>
        <span>
          Я соглашаюсь с
          <a class="brand-color italic" href="/privacy.pdf" target="_blank">
            политикой конфиденциальности
          </a>
          <br />
          и обработкой персональных данных
        </span>
      </label>
    </div>
    <div id="formMessage" class="success"></div>
  </form>
</dialog>

<style>
  @keyframes scale-down {
    from {
      opacity: 1;
      transform: scale(1);
    }
    to {
      opacity: 0;
      transform: scale(0.95);
    }
  }

  @keyframes scale-up {
    from {
      opacity: 0.3;
      transform: scale(0.95);
    }
    to {
      opacity: 1;
      transform: scale(1);
    }
  }

  @keyframes opacity-in {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  #formMessage {
    display: contents;
  }
  #feedbackDialog {
    border: none;
    padding: 7rem;
    width: 67vw;
    max-width: 75rem;
    background: #f8f2e9;
    margin: auto;
    animation: 0.4s scale-down forwards ease-out;
    animation-timing-function: var(--ease-squish-3);
  }

  #feedbackDialog[open] {
    animation: 0.4s scale-up forwards;
  }

  #feedbackDialog::backdrop {
    background: rgba(0, 0, 0, 0.6);
    backdrop-filter: blur(4px);
    animation: 0.4s opacity-in forwards ease-out;
  }

  .dialog-title {
    margin-top: 0;
    margin-bottom: 1.5rem;
    font-size: var(--fs-32);
    line-height: 2.4rem;
    color: var(--text-color-secondary);
    text-align: center;
  }

  #feedbackForm {
    max-width: 50%;
    margin: 0 auto;
  }

  #policy {
    width: 1rem;
    height: 1rem;
    background-color: #f0d8b5;
    border: 1px solid #caac81;
  }

  .form-group {
    margin: 0.625rem 0;
  }

  .form-input__label {
    display: block;
    margin-left: 0.5rem;
    margin-bottom: 0.25rem;
    font-size: var(--fs-14);
    line-height: var(--lh-14);
    color: var(--text-color-secondary);
  }

  .form-input {
    width: 100%;
    box-sizing: border-box;
    border: 1px solid #f7eee0;
    border-radius: 999px;
    font-size: 1rem;
    background-color: #fff9f0;
    padding: 0.75rem 1.5rem;
    color: var(--text-color-secondary);
  }

  .form-input:focus {
    outline: none;
    border-color: #f0d8b5;
  }

  .form-input.error {
    border-color: #e74c3c;
    background-color: #fdf2f2;
  }

  .error-message {
    display: contents;
    min-height: 1.25rem;
    font-size: var(--fs-14);
    line-height: var(--lh-14);
    color: #e74c3c;
  }

  .success {
    color: #27ae60;
    font-weight: 600;
    text-align: center;
    margin-bottom: 16px;
    min-height: 24px;
  }

  .form-actions {
    display: flex;
    flex-direction: column;
  }

  .form-actions button {
    cursor: pointer;
    background-color: #f0d8b5;
    transition:
      background-color 0.2s,
      transform 0.1s;
  }

  .confirm-buton {
    margin: 0.5rem 0;
    overflow: hidden;
    background-color: rgba(#f0d8b5, 1);
    color: #5a5348;
    font-size: var(--fs-18);
    line-height: var(--lh-18);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border: none;
    border-radius: 999px;
    text-align: center;
    display: inline-block;
    cursor: pointer;
    padding: 0.7em 2em;
    box-shadow: 0 10px 40px 10px rgb(255, 255, 255, 0);
    transition: all 0.2s ease-out;
  }

  @media (hover: hover) {
    .confirm-buton:hover {
      transform: scale(1.02) translateY(-5%);
      background-color: rgba(var(--backgroundColor), calc(var(--alpha) + 0.05));
      box-shadow: 0 4px 40px 20px rgb(255, 255, 255, 0.05);
    }
  }
  .confirm-buton:active {
    transform: scale(1.04) translateY(-5%);
    background-color: rgba(var(--backgroundColor), calc(var(--alpha) + 0.1));
  }
  .confirm-buton::before {
    content: "";
    background: linear-gradient(
      60deg,
      #0000,
      #0000,
      rgba(255, 255, 255, 0.15),
      #0000,
      #0000
    );
    width: 100%;
    height: 100%;
    animation: infinite slide-in 4s ease-out;
    position: absolute;
    top: 0;
    left: -100%;
    z-index: 1;
  }

  @keyframes slide-in {
    0%,
    20% {
      transform: translateX(0);
    }

    80%,
    100% {
      transform: translateX(300%);
    }
  }
  .agreement {
    user-select: none;
    margin: 0.625rem;
    display: flex;
    align-items: flex-start;
    gap: 0.625rem;
  }
  .agreement input {
    display: none;
  }

  .checkmark {
    display: inline-block;
    aspect-ratio: 1;
    height: 1rem;
    border-radius: 0.375rem;
    margin-top: 0.25rem;
    border: 1px solid #caac81;
    background-color: #fff9f0;
    vertical-align: middle;
    margin-right: 0.5rem;
    position: relative;
    transition:
      background-color 0.2s,
      border-color 0.2s;
  }

  .agreement input:checked + .checkmark {
    background-color: #f0d8b5;
    border-color: #caac81 !important;
    border: 1px solid;
  }

  .agreement input:checked + .checkmark::after {
    content: "";
    position: absolute;
    left: 0.275rem;
    top: 0.0625rem;
    width: 0.3125rem;
    height: 0.5625rem;
    border: solid #caac81;
    border-width: 0 0.125rem 0.125rem 0;
    transform: rotate(45deg);
  }
  .agreement input:checked + .checkmark:hover {
    background-color: #f0d8b5;
  }
  .confirm-buton:disabled {
    opacity: 0.6;
    cursor: not-allowed;
    transform: none !important;
    box-shadow: none !important;
  }
  .dialog-toolbar {
    position: absolute;
    top: 2rem;
    right: 2rem;
  }
  #closeButton:hover {
    cursor: pointer;
    color: var(--text-color-secondary);
  }

  @media (max-width: 1024px) {
    #feedbackDialog {
      padding: 0rem;
      width: 100vw;
      height: 70vh;
      display: flex;
      flex-direction: column;
      padding: 6rem 0;
    }
    #feedbackForm {
      margin-left: 1rem;
      margin-right: 1rem;
      flex: 1;
      max-width: 100%;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      gap: 1rem;
    }
    .form-inputs {
      flex: 1;
      display: flex;
      flex-direction: column;
      justify-content: center;
    }
    .dialog-toolbar {
      position: absolute;
      top: 1rem;
      right: 1rem;
    }
  }
</style>
<script>
  import IMask from "imask";
  const dialog = document.getElementById("feedbackDialog") as HTMLDialogElement;
  const openBtns = document.querySelectorAll(".openDialog");
  console.log(openBtns);
  const form = document.getElementById("feedbackForm") as HTMLFormElement;
  const nameInput = document.getElementById("name") as HTMLInputElement;
  const phoneInput = document.getElementById("phone") as HTMLInputElement;
  IMask(phoneInput, {
    mask: "0(000)000-00-00",
  });

  const nameError = document.getElementById("nameError") as HTMLDivElement;
  const phoneError = document.getElementById("phoneError") as HTMLDivElement;
  const formMessage = document.getElementById("formMessage") as HTMLDivElement;
  const confirmButton = document.getElementById(
    "confirmButton"
  ) as HTMLButtonElement;
  const closeButton = document.getElementById(
    "closeButton"
  ) as HTMLButtonElement;

  const checkbox = document.getElementById("policy");
  confirmButton.disabled = true;
  const API_URL = `${import.meta.env.PUBLIC_STRAPI_URL}/api/applications`;
  function clearErrors() {
    nameError.textContent = "";
    phoneError.textContent = "";
    nameInput.classList.remove("error");
    phoneInput.classList.remove("error");
    formMessage.textContent = "";
  }

  openBtns.forEach((button) => {
    button.addEventListener("click", () => {
      clearErrors();
      dialog.classList.remove("animate-out");
      dialog.showModal();
      dialog.classList.add("animate-in");
    });
  });
  closeButton.addEventListener("click", () => {
    clearErrors();
    dialog.classList.remove("animate-in");
    dialog.classList.add("animate-out");
    dialog.close();
  });
  form.addEventListener("submit", async (e) => {
    e.preventDefault();
    clearErrors();

    const name = nameInput.value.trim();
    const phone_number = phoneInput.value.trim();

    let hasError = false;

    if (!name) {
      nameError.textContent = "Пожалуйста, укажите имя.";
      nameInput.classList.add("error");
      hasError = true;
    }
    const cleanedNumber = phone_number.replace(/\D/g, "");
    const phoneRegex = /^[78]\d{10}$/;

    if (!phoneRegex.test(cleanedNumber)) {
      phoneError.textContent =
        "Телефон должен содержать ровно 11 цифр (например: 8(912)345-67-89).";
      phoneInput.classList.add("error");
      hasError = true;
    }

    if (hasError) return;

    try {
      const response = await fetch(API_URL, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          data: { phone_number, name },
        }),
      });

      if (response.ok) {
        formMessage.textContent = "Спасибо! Ваши данные успешно отправлены.";
        formMessage.className = "success";
        form.reset();
        setTimeout(() => {
          dialog.close();
          clearErrors();
        }, 1500);
      } else {
        throw new Error("Ошибка сервера");
      }
    } catch (error) {
      console.error("Ошибка:", error);
      formMessage.textContent =
        "Не удалось отправить данные. Попробуйте позже.";
      formMessage.className = "error-message";
    }
  });

  checkbox.addEventListener("change", () => {
    confirmButton.disabled = !checkbox.checked;
  });
</script>
