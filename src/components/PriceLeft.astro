---
import SectionAware from "../components/SectionAware.astro";
import PriceBackground from "../assets/images/price-section-background.webp";
import ShowCase from "../components/ShowCase.astro";
import { socialLinks } from "../social-links";
import ContactButton from "../components/ContactButton.astro";

const imageSources = [
  {
    srcset: PriceBackground.src,
    media: "(max-width: 1440px)",
    type: "image/png",
  },
];
---

<ShowCase cssClass="border-top border-bottom">
  <h2 slot="showcase__title" class="showcase__title fs-54">
    Проверьте <br />
    <span class="italic">свободную</span> дату
  </h2>
  <ContactButton link={socialLinks.tg} slot="showcase__contact-us" />
  <p slot="showcase__description" class="showcase__description">
    Планируете свадьбу? <br /> Узнайте, доступна ли ваша дата <br /> — она может быть
    уже почти вашей.
  </p>
</ShowCase>

<SectionAware
  class="background-image price-aware-image"
  sources={imageSources}
  src={PriceBackground.src}
  alt="Feature"
  height="100%"
  width="100%"
  preloadSections={1}
  sectionSelector="[data-section]"
/>
