---
import WorkflowSign from "../assets/icons/sign/workflow-sign.svg";
import SvgAnimation from "./SvgAnimation.astro";
import ContactButton from "./ContactButton.astro";
import { socialLinks } from "../social-links";

const { className } = Astro.props;
---

<div class="gradient-header">
  <div class="gradient-header-inner"></div>
</div>
<div class:list={[className, "section-column__wrapper relative"]}>
  <div class="section-column__wrapper-inner">
    <h2 class="section__title">
      Простая и <span class="brand-color italic underline">
        прозрачная
        <SvgAnimation style="bottom: -0.6rem;">
          <WorkflowSign />
        </SvgAnimation></span
      > организация
    </h2>
    <div>
      <ol class="custom-list">
        <li class="custom-list__item">
          <p class="custom-list__title">Живая встреча</p>
          <span class="custom-list__description">
            Первая встреча решает все! Важно понять образовалось ли между нами
            доверие и понимание процесса работы, ведь впереди нас ждет
            увлекательная подготовка к вашему главному дню!
          </span>
        </li>

        <li class="custom-list__item">
          <p class="custom-list__title">Заключение договора и анкета</p>
          <span class="custom-list__description">
            После заключения договора переходим к заполнению анкеты. Нам
            интересно все, что вам нравится и не нравится. Подробная информация
            о вас поможет качественно подготовиться к свадьбе.
          </span>
        </li>

        <li class="custom-list__item">
          <p class="custom-list__title">Свадебный сюжет</p>
          <span class="custom-list__description">
            Обсуждаются ваши пожелания и наши безумные идеи. Определяем вместе
            концепцию и стилистику свадьбы. Детально изучаем самые важные
            моменты и сокровенные желания, которые объединяют вас.
          </span>
        </li>

        <li class="custom-list__item">
          <p class="custom-list__title">Подбор пространства</p>
          <span class="custom-list__description">
            Поиск той самой подходящей площадки. Да-да, из ваших рассказов и
            даже скринов из свадебных порталов.
          </span>
        </li>

        <li class="custom-list__item">
          <p class="custom-list__title">Подбор команды</p>
          <span class="custom-list__description">
            Подбирается команда подрядчиков под бюджет проекта, которая будет
            созидать ваш день по ту сторону.
          </span>
        </li>

        <li class="custom-list__item">
          <p class="custom-list__title">Визуализация свадьбы</p>
          <span class="custom-list__description">
            Вместе согласовываем итоговый макет свадьбы, составляем тайминг до
            секунд и учитываем непредвиденные ситуации!
          </span>
        </li>

        <li class="custom-list__item">
          <p class="custom-list__title">День вашей свадьбы</p>
          <span class="custom-list__description">
            Команда организаторов будет контролировать весь процесс с самого
            раннего часа монтажа оборудования до ухода последнего гостя. Мы
            несем ответственность за красоту и качество вашей свадьбы.
          </span>
        </li>
      </ol>
      <div class="custom-list__button">
        <ContactButton
          link={socialLinks.tg}
          backgroundColor="240, 216, 181"
          alpha="1"
          textColor="rgba(85, 85, 85, 1)"
          target=""
        >
          Оставить заявку
        </ContactButton>
      </div>
    </div>
  </div>
</div>

<style>
  @media (min-width: 1025px) {
    .gradient-header {
      pointer-events: none;
      width: 100%;
      height: 100%;
      z-index: 2;
      position: absolute;
      top: 0;
      left: 0;
    }
    .gradient-header-inner {
      position: sticky;
      top: 0;
      left: 0;
      height: 9rem;
      background: linear-gradient(
        to bottom,
        var(--background-color) 90%,
        #ffffff00 100%
      );
    }
  }

  .custom-list {
    counter-reset: list-counter;
    list-style: none;
    padding-left: 0;
    text-align: center;
    margin-left: auto;
    margin-right: auto;
    margin-top: 3.875rem;
    max-width: 30.625rem;
  }

  .custom-list__title {
    margin-bottom: 1.33rem;
    text-align: center;
    text-transform: uppercase;
    font-size: var(--fs-16);
    color: var(--text-color-tertiary);
  }
  .custom-list__description {
    font-size: var(--fs-14);
    color: var(--text-color-secondary);
    text-align: center;
    margin-bottom: 4rem;
  }

  .custom-list__button {
    display: flex;
    justify-content: center;
    margin-bottom: 6rem;
  }

  .custom-list__item {
    counter-increment: list-counter;
    position: relative;

    color: var(--text-color-tertiary);

    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .custom-list__title::before {
    content: "(" counter(list-counter) ")";
    position: relative;
    padding-right: 1.5rem;
    left: 0;
    font-weight: 600;
    color: var(--brand-color);
  }
  @media (max-width: 455px) {
    .section__title {
      margin-top: 1rem;
    }
  }
</style>
