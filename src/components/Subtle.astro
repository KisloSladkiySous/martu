---
interface Props {
  lines: string[];
  delay?: number;
}
const { lines, delay = 200 } = Astro.props;
---

<script>
  import { stagger, animate, inView } from "motion";

  const transition = {
    duration: 0.8,
    delay: stagger(0.2, { startDelay: 0.3 }),
    easing: "ease-out",
  };

  const keyframes = {
    y: [50, 0],
    opacity: [0, 1],
    filter: ["blur(8px)", "blur(0px)"],
  };

  inView(
    ".subtle",
    (element) => {
      const lines = Array.from(element.querySelectorAll(".subtle__line"));
      const animation = animate(lines, keyframes, transition);
      animation.play();
      return () => animate(lines, { y: 50 }, { instant: true });
    },
    { amount: 0.5 }
  );
</script>

<div class="subtle" data-delay={delay}>
  {
    lines.map((line) => (
      <div class="subtle__row">
        <p class="subtle__line" set:html={line} />
      </div>
    ))
  }
</div>

<style>
  .subtle {
    text-align: center;
    color: var(--text-color-primary);
    font-size: var(--fs-14);
    line-height: var(--lh-14);
    text-transform: uppercase;
    margin-bottom: 2rem;
  }
  .subtle__line {
    display: inline-block;
    transform: translateY(100%);
    display: block;
  }
  .subtle__row {
    overflow: hidden;
  }

  @media (max-width: 475px) {
    .subtle {
      margin-bottom: min(max(0.75rem, 3vh), 2rem);
    }
  }
</style>
